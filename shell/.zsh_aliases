alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."

alias c="clear"

alias l="ls -lah"
alias ll="ls -l"
alias la="ls -A"
alias lt="lsd --tree --depth 2"

alias szsh="source ~/.zshrc"
alias ealias="nvim ~/.zsh_aliases"
alias ezsh="nvim ~/.zshrc"
alias edot="cd ~/dotfiles && nvim ."

alias gs="git status"
alias ga="git add"
alias gc="git commit"
alias gcm="git commit -m"
alias gp="git push origin HEAD"
alias gpl="git pull"
alias gcl="git clone"
alias gb="git branch"
alias gcb="git checkout -b"
alias gchb="git checkout"
alias gdb="git branch -d"
alias gl="git log --oneline"

alias ni="npm install"
alias nis="npm install --save"
alias nid="npm install --save-dev"
alias nu="npm uninstall"
alias nr="npm run"
alias nd="npm run dev"
alias nb="npm run build"

# ── Rust ──────────────────────────────────────────────────────────────────────
alias cr="cargo run"
alias cb="cargo build"
alias ct="cargo test"
alias cc="cargo clippy"
alias cf="cargo fmt"
alias cw="cargo watch -x run"
alias crr="cargo run --release"
alias cbr="cargo build --release"

alias ganache='~/Downloads/ganache-2.7.1-linux-x86_64.AppImage'

alias zen="zen-browser"

alias open="xdg-open"

alias d="docker"
alias sql="docker exec -it mysql-container mysql -u root -p"
alias dcu="docker compose up -d"
alias dcd="docker compose down"

alias ls="lsd"

alias warp="warp-cli"
alias wcon="warp-cli connect"
alias wd="warp-cli disconnect"
alias ws="warp-cli status"

alias t="tmux"
